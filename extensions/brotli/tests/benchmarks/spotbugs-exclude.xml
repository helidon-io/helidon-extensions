<FindBugsFilter>
    <!-- JMH-generated timing loops and padding fields are not handwritten benchmark code. -->
    <Match>
        <Class name="~io\.helidon\.extensions\.brotli\.benchmarks\.jmh_generated\..*"/>
    </Match>
    <!-- One-time trial fixtures need reproducible bytes, not cryptographic randomness. -->
    <Match>
        <Class name="io.helidon.extensions.brotli.benchmarks.BrotliBenchmark$Payload"/>
        <Method name="random"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE,PREDICTABLE_RANDOM"/>
    </Match>
</FindBugsFilter>
