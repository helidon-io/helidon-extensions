String tree = java.nio.file.Files.readString(new File(basedir, "target/runtime-dependencies.txt").toPath());
if (!tree.contains(":helidon-extensions-jakarta-dbclient-jsonp:")) {
    throw new IllegalStateException("Selected integration is missing: " + tree);
}
String[] forbidden = {
    ":helidon-http-media-jsonp:",
    ":helidon-http-media-jsonb:",
    ":helidon-dbclient-jsonp:",
    ":helidon-data-jakarta-persistence",
    ":helidon-transaction-",
    ":helidon-extensions-jakarta-data-persistence",
    ":helidon-extensions-jakarta-transaction-",
    ":helidon-extensions-jakarta-http-media-jsonp:",
    ":helidon-extensions-jakarta-http-media-jsonb:"
};
for (String artifact : forbidden) {
    if (tree.contains(artifact)) {
        throw new IllegalStateException("Unrelated integration " + artifact + " in runtime tree: " + tree);
    }
}
return true;
