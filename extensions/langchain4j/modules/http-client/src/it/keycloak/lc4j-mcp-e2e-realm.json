{
  "realm": "lc4j-mcp-e2e",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "lc4j-mcp-test",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "test-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lc4j-mcp-test",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Test",
      "email": "alice@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{"type": "password", "value": "alice-test-only", "temporary": false}]
    },
    {
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Test",
      "email": "bob@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{"type": "password", "value": "bob-test-only", "temporary": false}]
    }
  ]
}
