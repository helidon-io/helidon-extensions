    /** Dispatches native cascaded validation to the concrete generated model. */
    @io.helidon.service.registry.Service.Singleton
    @io.helidon.service.registry.Service.NamedByType({{classname}}.class)
    @io.helidon.common.Weight(io.helidon.common.Weighted.DEFAULT_WEIGHT + 10)
    public static final class {{vendorExtensions.x-runtime-type-validator-name}}
            implements io.helidon.validation.spi.TypeValidator<{{classname}}> {
