            this.registry = registry;
        }

        @Override
        public void check(io.helidon.validation.ValidationContext context, {{classname}} instance) {
            if (instance != null) {
                runtimeValidator(instance).check(context, instance);
            }
        }

        @Override
        public void check(io.helidon.validation.ValidationContext context, {{classname}} instance, String propertyName) {
            if (instance != null) {
                runtimeValidator(instance).check(context, instance, propertyName);
            }
        }

        @Override
        public void checkProperty(io.helidon.validation.ValidationContext context, String propertyName, Object value) {
            // No view instance is allocated: native property validation accepts the original value.
            registry.<io.helidon.validation.spi.TypeValidator<{{vendorExtensions.x-runtime-validation-properties-name}}>>get(
                            PROPERTY_CONTRACT, PROPERTY_QUALIFIER)
                    .checkProperty(context, propertyName, value);
