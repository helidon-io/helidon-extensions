                .builder(io.helidon.common.types.TypeName.create(io.helidon.validation.spi.TypeValidator.class))
                .addTypeArgument(io.helidon.common.types.TypeName.create(
                        {{vendorExtensions.x-runtime-validation-properties-name}}.class))
                .build();
        private static final io.helidon.service.registry.Qualifier PROPERTY_QUALIFIER =
                io.helidon.service.registry.Qualifier.createNamed(
                        {{vendorExtensions.x-runtime-validation-properties-name}}.class.getCanonicalName());
        private final io.helidon.service.registry.ServiceRegistry registry;

        /**
