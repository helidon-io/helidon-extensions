        private io.helidon.validation.spi.TypeValidator<Object> runtimeValidator({{classname}} instance) {
            Class<?> type = instance.getClass();
            if (type == {{classname}}.class) {
                throw new IllegalArgumentException("Expected a concrete subtype of {{classname}}");
