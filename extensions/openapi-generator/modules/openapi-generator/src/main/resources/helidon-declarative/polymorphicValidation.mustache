                    .builder(io.helidon.common.types.TypeName.create(io.helidon.validation.spi.TypeValidator.class))
                    .addTypeArgument(io.helidon.common.types.TypeName.create(type))
                    .build();
            return registry.getNamed(contract, type.getName());
        }
